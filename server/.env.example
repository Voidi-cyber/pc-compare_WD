# Змінні середовища (на платформі розгортання задаються в налаштуваннях; локально: node --env-file=.env index.js)
PORT=3000
# Шлях до файлу бази SQLite (на хмарній платформі — тека з постійним диском)
DB_FILE=./pc-compare.db
# Джерело, якому дозволено CORS (потрібно, лише якщо клієнт розміщено на іншому домені)
# CORS_ORIGIN=https://example.github.io
